STALE_AFTER_S = 120   # replies this much newer than the plan numbers trigger the warning
ENTRY_NAMES = {"claude-vscode": "VS Code", "claude-desktop": "the desktop app"}


def stale_note(w, recs, captured_at):
    """Warn when Claude replied after the plan numbers were saved, e.g. in the VS Code
    panel, which doesn't run the status line, so those replies aren't counted yet."""
    newer = [r for r in recs if r["t"] > captured_at + STALE_AFTER_S]
    # Terminal replies refresh the numbers themselves, so only they are left over when
    # a terminal session doesn't run the status line (for example, one started elsewhere).
    elsewhere = [r for r in newer if r["entry"] != "cli"]
    newer = elsewhere or newer
    if not newer:
        return []
    where = sorted({ENTRY_NAMES.get(r["entry"], "") for r in newer} - {""})
    src = " and ".join(where) if where else "sessions without the status line"
    if w >= 76:
        text = f"⚠ {len(newer)} newer replies in {src} aren't counted yet; they will be after the next terminal reply"
    elif w >= 44:
        text = f"⚠ {len(newer)} newer replies in {src} not counted yet"
    else:
        text = "⚠ newer replies not counted yet"
    return [[(text, st("hotkey"))]]


def plan_content(k, w, recs):
    now = time.time()
    from_line = load_json(os.path.join(STATE, "rate_limits.json"))
    checked = load_json(CHECKED_FILE)
    rl_file = max((f for f in (from_line, checked) if f), key=lambda f: f.get("captured_at", 0), default=None)
    if not rl_file:
        if checker and not checker.error:
            return [[("Checking plan limits...", st("dim"))]]
        note = [[(f"⚠ {checker.error}", st("hotkey"))]] if checker else []
        if w >= 60:
            return note + [[("No plan data yet. It appears after the next Claude reply", st("dim"))],
                           [("(needs the status line set up, and a Pro/Max/Ultra plan).", st("dim"))]]
        return note + [[("No data until the next reply.", st("dim"))]]
    rl = rl_file.get("rate_limits") or {}
    wins = [(key, label, short, rl.get(key)) for key, label, short in
            (("five_hour", "5-hour", "5h"), ("seven_day", "Weekly", "wk"))]
    # per-model weekly limits (e.g. Fable) only come from the check, never the status line
    wins += [("scoped", m.get("name", "?")[:10], m.get("name", "?")[:3], m) for m in (checked or {}).get("scoped") or []]
    wins.append(("spend_limit", "Spend", "$", rl.get("spend_limit")))
    lab_w = max(7, max(len(label) + 1 for _, label, _, _ in wins))
    rows = []
    for key, label, short, win in wins:
        if not isinstance(win, dict) or win.get("used_percentage") is None:
            continue
        p = float(win["used_percentage"])
        lab = f"{label:<{lab_w}}" if w >= 36 else f"{short:<4}"
        resets = win.get("resets_at")
        if resets and resets < now:
            rows.append((lab, None, "", ""))
            continue
        pct_txt = f" {p:5.1f}%" if w >= 36 else f" {p:3.0f}%"
        tail = ""
        if resets and w >= 68:
            when = time.strftime("%H:%M" if resets - now < 86400 else "%a %H:%M", time.localtime(resets))
            tail = f"   resets in {ago(resets - now)} ({when})"
        elif resets and w >= 40:
            tail = f"  in {ago(resets - now)}"
        if key == "spend_limit" and win.get("limit_usd") and w >= 96:
            tail += f"   ${win.get('used_usd', 0):.2f} / ${win['limit_usd']:.2f}"
        rows.append((lab, p, pct_txt, tail))
    lines = []
    if rows:
        bar_w = max(4, min(60, w - max(len(r[0]) + len(r[2]) + len(r[3]) for r in rows)))
        for lab, p, pct_txt, tail in rows:
            if p is None:
                lines.append([(lab, st("title", True)), ("reset; updates soon", st("dim"))])
                continue
            lines.append([(lab, st("title", True))] + meter(p, bar_w) +
                         [(pct_txt, pct_style(p, True)), (tail, st("dim"))])
    if checker and checker.error:
        lines.append([(f"⚠ live check: {checker.error}"[: max(1, w)], st("hotkey"))])
        lines += stale_note(w, recs, rl_file.get("captured_at", now))
    elif not checker:
        lines += stale_note(w, recs, rl_file.get("captured_at", now))
    age = ago(now - rl_file.get("captured_at", now))
    text = f"as of {age} ago" if w >= 26 else f"{age} ago"
    if checker and not checker.error and w >= 40:
        text += f" · checked every {ago(checker.every)}"
    lines.append([(text, st("dim"))])
    return lines


_bins_cache = {}


def graph_bins(w, recs):
    key = (w, len(recs), int(time.time()))
    if key not in _bins_cache:
        _bins_cache.clear()
        _bins_cache[key] = _graph_bins(w, recs)
    return _bins_cache[key]


def _graph_bins(w, recs):
    cells = max(4, min(w, 200))
    n = cells * 2                     # two time bins per character (braille has 2 dot columns)
    step = SPAN / n
    bins = [0] * n
    now = time.time()
    for r in recs:
        age = now - r["t"]
        if 0 <= age < SPAN:
            bins[n - 1 - int(age // step)] += r["out"]
    return bins, step


def graph_title(w, recs):
    bins, step = graph_bins(w, recs)
    peak = max(bins)
    if w >= 60:
        return "output tokens · last 5h", f"peak {human(peak)} per {step / 60:.1f} min"
    if w >= 30:
        return "output · 5h", f"peak {human(peak)}"
    return "output 5h", ""


def graph_content(k, w, recs):
    rows = k + 1
    bins, _ = graph_bins(w, recs)
    peak = max(bins) or 1
    levels = rows * 4
    hts = [0 if b == 0 else max(1, round(b / peak * levels)) for b in bins]
    lines = []
    for row in range(rows - 1, -1, -1):
        color = gradient(GRAPH_STOPS, row / max(1, rows - 1)) if rows > 1 else GRAPH_STOPS[1]
        pieces = []
        for c in range(len(bins) // 2):
            lft = max(0, min(4, hts[2 * c] - row * 4))
            rgt = max(0, min(4, hts[2 * c + 1] - row * 4))
            code = sum(BRAILLE_LEFT[:lft]) + sum(BRAILLE_RIGHT[:rgt])
            if code:
                pieces.append((chr(0x2800 + code), (color, False)))
            elif row == 0:
                pieces.append(("⣀", st("faint")))   # faint baseline, like btop
            else:
                pieces.append((" ", None))
        lines.append(pieces)
    # time axis with hour ticks
    cells = len(bins) // 2
    axis = [" "] * cells
    marks = [("now", cells - 3)]
    if cells >= 30:
        marks += [(f"-{h}h", round(cells * (1 - h / 5))) for h in (1, 2, 3, 4)]
    marks.append(("-5h", 0))
    for text, pos in marks:
        pos = max(0, min(cells - len(text), pos))
        if all(c == " " for c in axis[max(0, pos - 1):pos + len(text) + 1]):
            axis[pos:pos + len(text)] = list(text)
    lines.append([("".join(axis), st("dim"))])
    return lines


def tokens_content(k, w, recs):
    now = time.time()
    midnight = datetime.now().replace(hour=0, minute=0, second=0, microsecond=0).timestamp()
    periods = (("Last hour", "1h", now - 3600), ("Last 5 h", "5h", now - SPAN),
               ("Today", "today", midnight), ("Last 7 days", "7d", now - KEEP_S))
    hd = st("title", True)
    if w >= 64:
        lines = [[(f"{'':<12}{'replies':>9}{'input':>9}{'output':>9}{'cache read':>12}{'cache write':>13}", hd)]]
    elif w >= 39:
        lines = [[(f"{'':<12}{'replies':>8}{'output':>9}{'cache rd':>10}", hd)]]
    else:
        lines = [[(f"{'':<6}{'replies':>8}{'output':>8}", hd)]]
    for label, short, since in periods:
        sel = [r for r in recs if r["t"] >= since]
        n, inp, out = len(sel), human(sum(r["in"] for r in sel)), human(sum(r["out"] for r in sel))
        cr, cw = human(sum(r["cr"] for r in sel)), human(sum(r["cw"] for r in sel))
        if w >= 64:
            lines.append([(f"{label:<12}", st("text", True)), (f"{n:>9}{inp:>9}", st("text")),
                          (f"{out:>9}", st("out", True)), (f"{cr:>12}{cw:>13}", st("dim"))])
        elif w >= 39:
            lines.append([(f"{label:<12}", st("text", True)), (f"{n:>8}", st("text")),
                          (f"{out:>9}", st("out", True)), (f"{cr:>10}", st("dim"))])
        else:
            lines.append([(f"{short:<6}", st("text", True)), (f"{n:>8}", st("text")),
                          (f"{out:>8}", st("out", True))])
    return lines


def model_groups(recs):
    cutoff = time.time() - SPAN
    groups = {}
    for r in recs:
        if r["t"] >= cutoff:
            g = groups.setdefault((r["model"], r["project"]), [0, 0])
            g[0] += 1
            g[1] += r["out"]
    return sorted(groups.items(), key=lambda kv: -kv[1][1])[:MAX_GROUPS]


def models_content(k, w, groups):
    top = max((g[1][1] for g in groups), default=1) or 1
    lines = []
    for (model, proj), (cnt, out) in groups[:k + 1]:
        mc = (model_color(model), True)
        share = out / top
        if w >= 70:
            bar = round(10 * share)
            lines.append([(f"{model:<20.20} ", mc), (f"{proj:<20.20}", st("text")),
                          (f"{cnt:>5} replies ", st("dim")), (f"{human(out):>7} ", st("title", True)),
                          ("■" * bar, st("bar")), ("■" * (10 - bar), st("empty"))])
        else:
            m = model.replace("claude-", "")
            pw = max(4, w - 11 - 8)
            lines.append([(f"{m:<10.10} ", mc), (f"{proj:<{pw}.{pw - 1}}", st("text")),
                          (f"{human(out):>8}", st("title", True))])
    return lines


def sessions_content(k, w, sessions):
    now = time.time()
    if not sessions:
        return [[("None yet. Sessions appear after their next reply.", st("dim"))]]
    full = w >= 62
    hd = st("title", True)
    pw = max(6, w - 2 - 5 - 8)
    if full:
        lines = [[(f"  {'project':<18}{'model':<12}{'context':<12}{'cost*':>8}{'last reply':>12}", hd)]]
    else:
        lines = [[(f"  {'project':<{pw}}{'ctx':>5}{'last':>8}", hd)]]
    for s in sessions[:k + 1]:
        ctxp = (s.get("context") or {}).get("used_percentage")
        cost = (s.get("cost") or {}).get("total_cost_usd")
        proj = os.path.basename((s.get("cwd") or "?").rstrip("/")) or "/"
        age = now - s.get("captured_at", now)
        live = age < 600
        dot = ("● ", st("live" if live else "idle"))
        name = st("text", True) if live else st("dim")
        model = str(s.get("model"))
        if full:
            row = [dot, (f"{proj:<18.17}", name), (f"{model:<12.11}", (model_color(model), False) if live else st("dim"))]
            if ctxp is not None:
                row += meter(ctxp, 6) + [(f"{ctxp:>4.0f}% ", pct_style(ctxp) if live else st("dim"))]
            else:
                row.append((f"{'-':<12}", st("dim")))
            row += [(f"{'$%.2f' % cost if cost is not None else '-':>8}", st("cost") if live else st("dim")),
                    (f"{ago(age) + ' ago':>12}", st("dim"))]
            lines.append(row)
        else:
            lines.append([dot, (f"{proj:<{pw}.{pw - 1}}", name),
                          (f"{ctxp:>4.0f}%" if ctxp is not None else f"{'-':>5}",
                           pct_style(ctxp or 0) if live else st("dim")),
                          (f"{ago(age):>8}", st("dim"))])
    if full and w >= 86 and k + 1 >= len(sessions):
        lines.append([("* estimated at API list prices; on a subscription the plan limits are what count", st("faint"))])
    return lines


