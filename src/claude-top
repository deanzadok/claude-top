def meter(p, width):
    """btop-style meter: filled cells colored along the green->red gradient."""
    fill = round(width * min(max(p, 0), 100) / 100)
    pieces = []
    for i in range(width):
        if i < fill:
            pieces.append(("■", (gradient(METER_STOPS, i / max(1, width - 1)), False)))
        else:
            pieces.append(("■", st("empty")))
    return pieces


def pct_style(p, bold=False):
    return (gradient(METER_STOPS, min(max(p, 0), 100) / 100), bold)


