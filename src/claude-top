class Section:
    def __init__(self, name, prio, grow, kmax, title, content, nlines=None):
        self.name = name        # also picks the border color: THEME["box_" + name]
        self.prio = prio        # lower = kept first when space is short
        self.grow = grow        # lower = gets spare rows first
        self.kmax = kmax        # how far the section can grow (graph rows / list items)
        self.title = title      # title(width) -> (left title, right title)
        self._content = content # content(k, width) -> lines
        self._nlines = nlines   # optional fast nlines(k, width), to skip building content
        self._cache = {}

    def content(self, k, width):
        if (k, width) not in self._cache:
            self._cache[(k, width)] = self._content(k, width)
        return self._cache[(k, width)]

    def nlines(self, k, width):
        return self._nlines(k, width) if self._nlines else len(self.content(k, width))


def _choose(sections, height, rows_of):
    """Take sections in priority order while they fit (stop at the first that doesn't),
    then give spare rows to sections that can grow. Returns ({section: k}, rows used)."""
    size, used = {}, 0
    for s in sorted(sections, key=lambda s: s.prio):
        n = rows_of(s, 0)
        if used + n > height:
            break
        size[s] = 0
        used += n
    for s in sorted(size, key=lambda s: s.grow):
        while size[s] < s.kmax:
            delta = rows_of(s, size[s] + 1) - rows_of(s, size[s])
            if used + delta > height:
                break
            size[s] += 1
            used += delta
    return size, used


def draw_box(out, y, x, w, h, section, k):
    border = st("box_" + section.name)
    title, right = section.title(w - 4)
    iw = w - 4
    title = title[: max(0, w - 6)]
    top = [("╭─┐", border), (title, st("title", True)), ("┌", border)]
    used = 4 + len(title)
    if right and used + len(right) + 4 <= w:
        top += [("─" * (w - used - len(right) - 4), border), ("┐", border), (right, st("text")), ("┌─╮", border)]
    else:
        top += [("─" * max(0, w - used - 1), border), ("╮", border)]
    place(out, y, x, w, [top])
    content = section.content(k, iw)[: h - 2]
    for i in range(h - 2):
        out.append((y + 1 + i, x, "│", border))
        out.append((y + 1 + i, x + w - 1, "│", border))
    place(out, y + 1, x + 2, iw, content)
    place(out, y + h - 1, x, w, [[("╰" + "─" * (w - 2) + "╯", border)]])


def layout_column(out, sections, top, x, width, height):
    """Draw sections in boxes, stretching the last box to the bottom like btop.
    If boxes would hide sections that fit without them, use a compact borderless view."""
    boxed, used_b = _choose(sections, height, lambda s, k: s.nlines(k, width - 4) + 2)
    flat, used_f = _choose(sections, height, lambda s, k: s.nlines(k, width - 1) + 1)
    if len(boxed) >= len(flat) and boxed:
        shown = [s for s in sections if s in boxed]
        y = top
        for i, s in enumerate(shown):
            h = s.nlines(boxed[s], width - 4) + 2
            if i == len(shown) - 1:
                h += height - used_b
            draw_box(out, y, x, width, h, s, boxed[s])
            y += h
        return
    if not flat:   # not even one section fits: show the most important one, cut off
        s = min(sections, key=lambda s: s.prio)
        flat = {s: 0}
    y = top
    for s in [s for s in sections if s in flat]:
        title, right = s.title(width - 1)
        lines = [[(title, (THEME["box_" + s.name], True)), ("  " + right if right else "", st("dim"))]]
        lines += [[(" ", None)] + ln for ln in s.content(flat[s], width - 1)]
        lines = lines[: top + height - y]
        place(out, y, x, width, lines)
        y += len(lines)


def place(out, y, x, width, lines):
    for i, pieces in enumerate(lines):
        col = x
        for text, style in pieces:
            text = text[: max(0, x + width - col)]
            if text:
                out.append((y + i, col, text, style))
                col += len(text)


def frame(scanner, h, w):
    """Lay out the whole screen for h rows x w columns. Returns (row, col, text, style) items."""
    if w < 24 or h < 3:
        msg = "claude-top: window too small" if w >= 30 else "too small"
        return [(0, 0, msg[: max(1, w - 1)], st("hotkey", True))]
    usable = w - 1  # never write the last column (avoids curses errors at the corner)
    now = time.time()
    recs = list(scanner.records.values())
    sessions = [s for s in load_sessions() if now - s.get("captured_at", 0) < 24 * 3600][:MAX_SESSIONS]
    groups = model_groups(recs)

    out = []
    place(out, 0, 0, usable, [header_line(usable)])
    top, avail = 1, h - 1

    plan = Section("plan", 1, 9, 0, lambda cw: plan_title(cw, recs), lambda k, cw: plan_content(k, cw, recs))
    graph = Section("graph", 2, 3, GRAPH_MAX_ROWS - 1, lambda cw: graph_title(cw, recs),
                    lambda k, cw: graph_content(k, cw, recs), nlines=lambda k, cw: k + 2)
    tokens = Section("tokens", 3, 9, 0, lambda cw: ("tokens · all sessions", ""),
                     lambda k, cw: tokens_content(k, cw, recs))
    sess = Section("sessions", 4, 1, max(0, len(sessions) - 1),
                   lambda cw: ("sessions · last 24h", f"{len(sessions)} seen"),
                   lambda k, cw: sessions_content(k, cw, sessions))
    models = Section("models", 5, 2, max(0, len(groups) - 1), lambda cw: ("by model / project · 5h", ""),
                     lambda k, cw: models_content(k, cw, groups))
    right = [tokens] + ([models] if groups else []) + [sess]

    if w >= TWO_COLUMN_MIN:
        left_w = usable // 2
        layout_column(out, [plan, graph], top, 0, left_w, avail)
        layout_column(out, right, top, left_w, usable - left_w, avail)
    else:
        layout_column(out, [plan, graph] + right, top, 0, usable, avail)
    return out


