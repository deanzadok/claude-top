_CUBE = (0, 95, 135, 175, 215, 255)
_BASIC = ((0, 0, 0), (205, 0, 0), (0, 205, 0), (205, 205, 0),
          (0, 0, 238), (205, 0, 205), (0, 205, 205), (229, 229, 229))


def _rgb(hexc):
    return tuple(int(hexc[i:i + 2], 16) for i in (1, 3, 5))


def _dist(a, b):
    return sum((x - y) ** 2 for x, y in zip(a, b))


_xterm_cache = {}


def xterm(hexc):
    """Nearest xterm-256 palette index for a hex color."""
    if hexc not in _xterm_cache:
        rgb = _rgb(hexc)
        idx = [min(range(6), key=lambda i: abs(_CUBE[i] - v)) for v in rgb]
        cube = 16 + 36 * idx[0] + 6 * idx[1] + idx[2]
        cube_rgb = tuple(_CUBE[i] for i in idx)
        g = max(0, min(23, round((sum(rgb) / 3 - 8) / 10)))
        gray_rgb = (8 + 10 * g,) * 3
        _xterm_cache[hexc] = cube if _dist(rgb, cube_rgb) <= _dist(rgb, gray_rgb) else 232 + g
    return _xterm_cache[hexc]


def basic(hexc):
    rgb = _rgb(hexc)
    return min(range(8), key=lambda i: _dist(rgb, _BASIC[i]))


def gradient(stops, t):
    """Color at position t (0..1) along a list of hex color stops."""
    t = round(max(0.0, min(1.0, t)) * 23) / 23   # 24 steps keeps the number of colors small
    seg = min(len(stops) - 2, int(t * (len(stops) - 1)))
    local = t * (len(stops) - 1) - seg
    a, b = _rgb(stops[seg]), _rgb(stops[seg + 1])
    return "#%02x%02x%02x" % tuple(round(x + (y - x) * local) for x, y in zip(a, b))


