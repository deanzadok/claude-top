# ---------- reading the logs ----------

class LogScanner:
    """Reads new lines from the transcript files incrementally and keeps one
    record per API reply (replies are logged several times; we dedupe by id)."""

    def __init__(self):
        self.offsets = {}   # path -> (inode, byte offset)
        self.records = {}   # (message id, request id) -> record

    def scan(self):
        cutoff = time.time() - KEEP_S
        for path in glob.glob(os.path.join(PROJECTS, "**", "*.jsonl"), recursive=True):
            try:
                st = os.stat(path)
            except OSError:
                continue
            if st.st_mtime < cutoff:
                continue
            inode, off = self.offsets.get(path, (st.st_ino, 0))
            if inode != st.st_ino or st.st_size < off:
                off = 0
            if st.st_size == off:
                continue
            project = os.path.relpath(path, PROJECTS).split(os.sep)[0]
            try:
                with open(path, "rb") as f:
                    f.seek(off)
                    chunk = f.read()
            except OSError:
                continue
            end = chunk.rfind(b"\n")
            if end < 0:
                continue
            for line in chunk[:end].split(b"\n"):
                if b'"usage"' not in line or b'"assistant"' not in line:
                    continue
                self._add(line, project)
            self.offsets[path] = (st.st_ino, off + end + 1)
        self.records = {k: r for k, r in self.records.items() if r["t"] >= cutoff}

    def _add(self, line, project):
        try:
            d = json.loads(line)
            if d.get("type") != "assistant":
                return
            m = d["message"]
            u = m["usage"]
            t = datetime.fromisoformat(d["timestamp"].replace("Z", "+00:00")).timestamp()
        except Exception:
            return
        if m.get("model") in (None, "<synthetic>"):
            return
        key = (m.get("id"), d.get("requestId"))
        self.records[key] = {
            "t": t,
            "model": m.get("model"),
            "project": os.path.basename((d.get("cwd") or "").rstrip("/")) or short_project(project),
            "in": u.get("input_tokens") or 0,
            "out": u.get("output_tokens") or 0,
            "cr": u.get("cache_read_input_tokens") or 0,
            "cw": u.get("cache_creation_input_tokens") or 0,
            "entry": d.get("entrypoint") or "",
        }


def load_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except Exception:
        return None


def load_sessions():
    out = []
    now = time.time()
    for p in glob.glob(os.path.join(STATE, "sessions", "*.json")):
        s = load_json(p)
        if not s:
            continue
        if now - s.get("captured_at", 0) > KEEP_S:
            try:
                os.remove(p)
            except OSError:
                pass
            continue
        out.append(s)
    return sorted(out, key=lambda s: -s.get("captured_at", 0))


