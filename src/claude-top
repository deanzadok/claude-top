class Painter:
    """Turns (hex color, bold) styles into curses attributes, creating color pairs on demand.

    If the terminal lets programs redefine its palette, each hex color gets its own palette
    slot set to the exact color (the palette is restored on exit). Otherwise colors are
    matched to the nearest of the terminal's 256 (or 8) colors."""

    def __init__(self, transparent):
        self.c256 = curses.COLORS >= 256
        self.exact = (self.c256 and curses.can_change_color()
                      and not os.environ.get("CLAUDE_TOP_NO_EXACT_COLORS"))
        self.transparent = transparent
        self.max_pairs = min(curses.COLOR_PAIRS, 256) - 1
        self.reset()

    def reset(self):
        """Call after switching theme: new background, colors and pairs rebuilt on demand."""
        self.slots = {}
        self.pairs = {}
        self.bg = -1 if (self.transparent or not self.c256) else self.color(THEME["bg"])

    def color(self, hexc):
        if not self.c256:
            return basic(hexc)
        if not self.exact:
            return xterm(hexc)
        if hexc not in self.slots:
            idx = 16 + len(self.slots)
            if idx > 255:   # out of palette slots (not expected): fall back to text color
                return self.slots.get(THEME["text"], 16)
            global EXACT_COLORS_USED
            EXACT_COLORS_USED = True
            r, g, b = _rgb(hexc)
            curses.init_color(idx, r * 1000 // 255, g * 1000 // 255, b * 1000 // 255)
            self.slots[hexc] = idx
        return self.slots[hexc]

    def attr(self, style):
        if not style:
            style = st("text")
        hexc, bold = style
        fg = self.color(hexc)
        key = (fg, self.bg)
        if key not in self.pairs:
            if len(self.pairs) >= self.max_pairs:
                return curses.A_BOLD if bold else 0
            n = len(self.pairs) + 1
            curses.init_pair(n, fg, self.bg)
            self.pairs[key] = n
        return curses.color_pair(self.pairs[key]) | (curses.A_BOLD if bold else 0)


def run_curses(stdscr, scanner, transparent):
    try:
        curses.curs_set(0)
    except curses.error:
        pass
    curses.use_default_colors()
    paint = Painter(transparent)
    stdscr.bkgd(" ", paint.attr(st("text")))
    stdscr.timeout(REFRESH_S * 1000)
    last_scan = 0
    while True:
        if time.time() - last_scan >= SCAN_S:
            scanner.scan()
            last_scan = time.time()
        h, w = stdscr.getmaxyx()
        stdscr.erase()
        for y, x, text, style in frame(scanner, h, w):
            if y < h and x < w:
                try:
                    stdscr.addstr(y, x, text, paint.attr(style))
                except curses.error:
                    pass
        stdscr.refresh()
        key = stdscr.getch()
        if key == curses.KEY_RESIZE:
            stdscr.clear()  # full repaint at the new size, right away
            continue
        if key in (ord("q"), ord("Q"), 27):
            return
        if key in (ord("t"), ord("T")):
            step = 1 if key == ord("t") else -1
            set_theme(THEME_ORDER[(THEME_ORDER.index(theme_name) + step) % len(THEME_ORDER)])
            save_theme(theme_name)
            paint.reset()
            stdscr.bkgd(" ", paint.attr(st("text")))
            stdscr.clear()
            continue
        if key in (ord("r"), ord("R")):
            scanner.offsets.clear()
            scanner.records.clear()
            last_scan = 0
            if checker:
                checker.now()


def snapshot(scanner, h, w, color, transparent):
    grid = [[(" ", None)] * w for _ in range(h)]
    for y, x, text, style in frame(scanner, h, w):
        for i, ch in enumerate(text):
            if y < h and x + i < w:
                grid[y][x + i] = (ch, style)
    rows = []
    for r in grid:
        while r and r[-1][0] == " ":
            r = r[:-1]
        rows.append(r)
    while rows and not rows[-1]:
        rows.pop()
    for r in rows:
        if not color:
            print("".join(ch for ch, _ in r))
            continue
        truecolor = os.environ.get("COLORTERM") in ("truecolor", "24bit")

        def sgr(hexc, layer):   # layer 38 = text color, 48 = background
            return f"{layer};2;%d;%d;%d" % _rgb(hexc) if truecolor else f"{layer};5;{xterm(hexc)}"

        bg = "" if transparent else f"\x1b[{sgr(THEME['bg'], 48)}m"
        line = []
        for ch, style in r:
            hexc, bold = style or st("text")
            line.append(f"\x1b[0m{bg}\x1b[{'1;' if bold else ''}{sgr(hexc, 38)}m{ch}")
        print("".join(line) + "\x1b[0m")


def main():
    args = sys.argv[1:]
    if "-h" in args or "--help" in args:
        print(__doc__.strip())
        return
    transparent = "--transparent" in args
    if "--themes" in args:
        print("Themes (press t / T in claude-top to cycle):", ", ".join(THEME_ORDER))
        return
    if "--theme" in args:
        name = args[args.index("--theme") + 1] if args.index("--theme") + 1 < len(args) else ""
        if name not in THEMES:
            sys.exit(f"Unknown theme '{name}'. Choose from: {', '.join(THEME_ORDER)}")
        set_theme(name)
        if "--once" not in args:   # a snapshot is a preview; don't change the saved choice
            save_theme(name)
    else:
        set_theme(saved_theme())
    global checker
    every = CHECK_S
    if "--check-every" in args:
        try:
            every = max(CHECK_MIN_S, int(args[args.index("--check-every") + 1]))
        except (IndexError, ValueError):
            sys.exit("--check-every needs a number of seconds, e.g. --check-every 120")
    scanner = LogScanner()
    if "--once" in args:
        if "--no-check" not in args:
            check_plan_limits()   # a snapshot waits for fresh numbers (about a second)
        scanner.scan()
        if "--size" in args:
            w, h = (int(v) for v in args[args.index("--size") + 1].lower().split("x"))
        elif sys.stdout.isatty():
            w, h = os.get_terminal_size()
        else:
            w, h = 100, 60
        color = "--color" in args or (sys.stdout.isatty() and "--no-color" not in args)
        snapshot(scanner, h, w, color, transparent)
        return
    print("Reading Claude Code logs...", flush=True)
    if "--no-check" not in args:
        checker = LimitChecker(every)
    scanner.scan()
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    signal.signal(signal.SIGHUP, lambda *_: sys.exit(0))
    try:
        curses.wrapper(run_curses, scanner, transparent)
    except KeyboardInterrupt:
        pass
    finally:
        if EXACT_COLORS_USED:   # give the terminal its own palette back
            sys.stdout.write("\x1b]104\x07")
            sys.stdout.flush()


if __name__ == "__main__":
    main()
