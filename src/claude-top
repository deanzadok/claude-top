def header_line(w):
    clock = time.strftime("%H:%M:%S")
    if w < 64:
        return [("✻ claude-top ", st("accent", True)), (clock, st("text", True))]
    left = [(" ✻ claude", st("accent", True)), ("-top ", st("title", True))]
    keys = [(" ", None), ("q", st("hotkey", True)), (" quit  ", st("dim")),
            ("r", st("hotkey", True)), (" rescan  ", st("dim")),
            ("t", st("hotkey", True)), (" theme", st("dim"))]
    name, ms, pad = (f":{theme_name}", st("text")), (f"  {REFRESH_S * 1000}ms", st("dim")), (" ", None)
    mid = f" {time.strftime('%a')} {clock} "
    lw = sum(len(t) for t, _ in left)
    for extra in ([name, ms, pad], [name, pad], [pad], []):   # drop extras until it fits
        right = keys + extra
        if w - lw - sum(len(t) for t, _ in right) - len(mid) >= 4:
            break
    rw = sum(len(t) for t, _ in right)
    gap = w - lw - rw - len(mid)
    a = max(1, gap // 2)
    b = max(1, gap - a)
    return left + [("─" * a, st("faint")), (mid, st("title", True)), ("─" * b, st("faint"))] + right


