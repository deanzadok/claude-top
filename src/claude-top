def find_claude():
    path = os.environ.get("CLAUDE_TOP_CLAUDE") or shutil.which("claude")
    if not path:
        for p in ("~/.local/bin/claude", "~/.claude/local/claude"):
            p = os.path.expanduser(p)
            if os.access(p, os.X_OK):
                return p
    return path


def _epoch(iso):
    try:
        return datetime.fromisoformat(str(iso).replace("Z", "+00:00")).timestamp()
    except (TypeError, ValueError):
        return None


def convert_usage(resp):
    """Turn the CLI's usage answer into the status line's format, plus per-model limits."""
    rl = resp.get("rate_limits") or {}
    out, scoped = {}, []
    for lim in rl.get("limits") or []:
        if not isinstance(lim, dict) or lim.get("percent") is None:
            continue
        win = {"used_percentage": float(lim["percent"]), "resets_at": _epoch(lim.get("resets_at"))}
        model = ((lim.get("scope") or {}).get("model") or {})
        if lim.get("kind") == "session":
            out["five_hour"] = win
        elif lim.get("kind") == "weekly_all":
            out["seven_day"] = win
        elif lim.get("kind") == "weekly_scoped" and (model.get("display_name") or model.get("id")):
            scoped.append(dict(win, name=model.get("display_name") or model.get("id")))
    # Per-model limits are always in model_scoped. The limits list above is missing when
    # claude answers from its cache, so it can't be relied on for them.
    if isinstance(rl.get("model_scoped"), list):
        scoped = [{"name": m.get("display_name"), "used_percentage": float(m["utilization"]),
                   "resets_at": _epoch(m.get("resets_at"))}
                  for m in rl["model_scoped"]
                  if isinstance(m, dict) and m.get("display_name") and m.get("utilization") is not None]
    for key in ("five_hour", "seven_day"):   # cached answers only have these fields
        win = rl.get(key)
        if key not in out and isinstance(win, dict) and win.get("utilization") is not None:
            out[key] = {"used_percentage": float(win["utilization"]), "resets_at": _epoch(win.get("resets_at"))}
    extra = rl.get("extra_usage") or {}
    if extra.get("is_enabled") and extra.get("utilization") is not None:
        out["spend_limit"] = {"used_percentage": float(extra["utilization"])}
    return out, scoped


def check_plan_limits():
    """Ask the `claude` command for the account's current plan limits, the same numbers
    /usage shows. No prompt is sent, so this uses none of your limits. Saves them to
    CHECKED_FILE. Returns None on success, or a short reason it didn't work."""
    claude = find_claude()
    if not claude:
        return "`claude` command not found"
    req = json.dumps({"type": "control_request", "request_id": "usage", "request": {"subtype": "get_usage", "skip_behaviors": True}})
    try:
        os.makedirs(STATE, exist_ok=True)
        p = subprocess.run(
            [claude, "-p", "--input-format", "stream-json", "--output-format", "stream-json", "--verbose",
             "--no-session-persistence", "--strict-mcp-config", "--settings", '{"disableAllHooks": true}'],
            input=req + "\n", capture_output=True, text=True, timeout=CHECK_TIMEOUT_S,
            cwd=STATE, start_new_session=True)
    except subprocess.TimeoutExpired:
        return "`claude` didn't answer in time"
    except OSError as e:
        return f"couldn't run `claude` ({e.strerror})"
    for line in p.stdout.splitlines():
        try:
            d = json.loads(line)
        except ValueError:
            continue
        r = d.get("response") or {}
        if d.get("type") != "control_response" or r.get("request_id") != "usage":
            continue
        if r.get("subtype") != "success":
            return "`claude` couldn't get usage (signed in?)"
        resp = r.get("response") or {}
        if not resp.get("rate_limits_available", True) or not resp.get("rate_limits"):
            return "no plan limits for this account"
        rl, scoped = convert_usage(resp)
        if not rl and not scoped:
            return "no plan limits in the answer"
        tmp = f"{CHECKED_FILE}.{os.getpid()}.tmp"
        with open(tmp, "w") as f:
            json.dump({"captured_at": time.time(), "rate_limits": rl, "scoped": scoped,
                       "plan": resp.get("subscription_type")}, f)
        os.replace(tmp, CHECKED_FILE)
        return None
    return "`claude` gave no usage answer (needs a newer Claude Code?)"


class LimitChecker:
    """Runs check_plan_limits() in the background every CHECK_S seconds, or sooner on request."""

    def __init__(self, every):
        self.every = every
        self.error = None
        self.last_try = 0
        self.wake = threading.Event()
        threading.Thread(target=self._loop, daemon=True).start()

    def now(self):
        self.wake.set()

    def _loop(self):
        while True:
            self.last_try = time.time()
            try:
                self.error = check_plan_limits()
            except Exception as e:   # never let the checker take the screen down
                self.error = f"check failed ({type(e).__name__})"
            self.wake.wait(self.every)
            self.wake.clear()


